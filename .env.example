# Telegram Bot Token (required)
# Get it from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Spotify API credentials (OPTIONAL - works without them!)
# Only add if you have your own Spotify Developer credentials
# Get from https://developer.spotify.com/dashboard
# SPOTDL_CLIENT_ID=your_client_id_here
# SPOTDL_CLIENT_SECRET=your_client_secret_here
